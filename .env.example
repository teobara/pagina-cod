# Copiază acest fișier în .env pentru rulare locală (npm run dev).
# Pe Railway NU folosi .env — setează aceste valori în tab-ul "Variables" al serviciului.

ADMIN_USER=admin
ADMIN_PASSWORD=schimba-ma

# Șir aleator lung (ex: rezultatul lui: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Dacă lipsește, sesiunea de admin expiră la fiecare restart al serverului.
SESSION_SECRET=

# Pe Railway: calea către fișierul SQLite din volumul persistent (ex: volum montat la /data)
# DB_PATH=/data/codes.db

PORT=3100
